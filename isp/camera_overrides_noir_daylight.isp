#
# ISP overrides for the OV5647 NoIR module (no infrared cut filter) on
# L4T R32 and R35, for daylight. The same LED sources as
# camera_overrides_noir.isp plus a daylight white measured in shade,
# with the lux prior of the white balance off and the sensor black
# level subtracted. Checked outdoors on a Nano (R32) and a Xavier NX
# (R35). Generated by tools/isp/make-override.py from
# camera_overrides_noir_daylight.json. See docs/isp-tuning.md.
#
# A failed attempt, kept for reference. The NoIR module records
# infrared, and outdoors the colours stay poor. The mean error is 23
# to 30 with saturation=1.5 on nvarguscamerasrc.
#
# Daylight only. The black level is right at low gain. In the binned
# modes the sensor black falls in dim light, and this file then crushes
# the shadows. Indoors it does worse than camera_overrides_noir.isp.
# Outdoors, saturation=1.5 on nvarguscamerasrc brings back some of the
# colour the infrared takes.
#
# Install:
#   sudo cp camera_overrides_noir_daylight.isp /var/nvidia/nvcam/settings/camera_overrides.isp
#   sudo chmod 664 /var/nvidia/nvcam/settings/camera_overrides.isp
#   sudo rm -f /var/nvidia/nvcam/settings/nvcam_cache_*.bin
#   sudo systemctl restart nvargus-daemon
# A line Argus rejects stops the camera, and journalctl -u nvargus-daemon
# names it.

# White balance: the white of each source, raw R, Gr, Gb and B
# scaled so that the largest is 900. The clamps the generic tuning
# puts on the white estimate are opened up.
awb.v4.FusionLights[0] = {900,796,796,412}; # source A, warm
awb.v4.FusionLights[1] = {810,900,900,596}; # source B, neutral
awb.v4.FusionLights[2] = {668,900,900,696}; # source C, cool
awb.v4.FusionLights[3] = {900,796,796,412}; # source A, warm
awb.v4.FusionLights[4] = {810,900,900,596}; # source B, neutral
awb.v4.FusionLights[5] = {900,888,888,727}; # daylight shade
awb.v4.FusionLights[6] = {810,900,900,596}; # source B, neutral
awb.v4.FusionLights[7] = {668,900,900,696}; # source C, cool
awb.v4.FusionInitLight = 4;
awb.LowU = 0.05;
awb.HighU = 4.0;
awb.GrayLineThickness = 1.0;
awb.NumGrayLineSoftClampPoints = 0;
awb.v4.LowU = 0.05;
awb.v4.HighU = 4.0;
awb.v4.GrayLineThickness = 1.0;
awb.v4.NumGrayLineSoftClampPoints = 0;

# The lux prior of the generic tuning pulls the white towards a
# daylight setting of another sensor in bright scenes.
awb.v4.FusionUseLux = FALSE;

# The sensor black level, which the generic tuning does not subtract.
opticalBlack.float.manualBiasR = 0.0146;
opticalBlack.float.manualBiasGR = 0.0146;
opticalBlack.float.manualBiasGB = 0.0146;
opticalBlack.float.manualBiasB = 0.0146;

# Colour matrices by the colour temperature the ISP estimates. Each
# row is an input channel.
colorCorrection.numColorCorrectionMatrices = 4;
colorCorrection.set[0].cct = 3500;
colorCorrection.set[0].ccMatrix[0] = { 2.0825, -0.7282, -0.0005, 0.0 };
colorCorrection.set[0].ccMatrix[1] = { -0.5450, 2.0517, -2.4570, 0.0 };
colorCorrection.set[0].ccMatrix[2] = { -0.5375, -0.3235, 3.4575, 0.0 };
colorCorrection.set[0].ccMatrix[3] = { 0.0, 0.0, 0.0, 1.0 };
colorCorrection.set[1].cct = 4230;
colorCorrection.set[1].ccMatrix[0] = { 1.0035, -1.6776, -1.2689, 0.0 };
colorCorrection.set[1].ccMatrix[1] = { 0.6921, 3.4230, -0.8128, 0.0 };
colorCorrection.set[1].ccMatrix[2] = { -0.6956, -0.7454, 3.0817, 0.0 };
colorCorrection.set[1].ccMatrix[3] = { 0.0, 0.0, 0.0, 1.0 };
colorCorrection.set[2].cct = 4600;
colorCorrection.set[2].ccMatrix[0] = { 2.1780, -0.5879, 0.0800, 0.0 };
colorCorrection.set[2].ccMatrix[1] = { -0.7704, 1.9581, -2.0208, 0.0 };
colorCorrection.set[2].ccMatrix[2] = { -0.4076, -0.3703, 2.9409, 0.0 };
colorCorrection.set[2].ccMatrix[3] = { 0.0, 0.0, 0.0, 1.0 };
colorCorrection.set[3].cct = 5500;
colorCorrection.set[3].ccMatrix[0] = { 2.3275, -0.5291, 0.0425, 0.0 };
colorCorrection.set[3].ccMatrix[1] = { -0.9196, 1.9560, -1.6844, 0.0 };
colorCorrection.set[3].ccMatrix[2] = { -0.4079, -0.4269, 2.6419, 0.0 };
colorCorrection.set[3].ccMatrix[3] = { 0.0, 0.0, 0.0, 1.0 };
