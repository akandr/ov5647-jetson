#
# ISP overrides for the OV5647 NoIR module (no infrared cut filter) on
# L4T R32 and R35, for LED light. Fitted to a ColorChecker on raw
# frames from two modules under three LED sources, and checked on the
# ISP output of a Nano (R32) and a Xavier NX (R35). Generated by
# tools/isp/make-override.py from camera_overrides_noir.json. See
# docs/isp-tuning.md. Not for daylight, see the Outdoors section there.
#
# The white points are the mean of two modules. The modules differ by
# about 3% in R/G and 6% in B/G. Slot 5 and the 8500 K set repeat
# source C, with its matrix as fitted. The other LED matrices have a
# saturation of 1.2 folded in.
#
# Install:
#   sudo cp camera_overrides_noir.isp /var/nvidia/nvcam/settings/camera_overrides.isp
#   sudo chmod 664 /var/nvidia/nvcam/settings/camera_overrides.isp
#   sudo rm -f /var/nvidia/nvcam/settings/nvcam_cache_*.bin
#   sudo systemctl restart nvargus-daemon
# A line Argus rejects stops the camera, and journalctl -u nvargus-daemon
# names it.

# White balance: the white of each source, raw R, Gr, Gb and B
# scaled so that the largest is 900. The clamps the generic tuning
# puts on the white estimate are opened up.
awb.v4.FusionLights[0] = {900,796,796,412}; # source A, warm
awb.v4.FusionLights[1] = {810,900,900,596}; # source B, neutral
awb.v4.FusionLights[2] = {668,900,900,696}; # source C, cool
awb.v4.FusionLights[3] = {900,796,796,412}; # source A, warm
awb.v4.FusionLights[4] = {810,900,900,596}; # source B, neutral
awb.v4.FusionLights[5] = {668,900,900,696}; # source C, cool, above 5500 K
awb.v4.FusionLights[6] = {810,900,900,596}; # source B, neutral
awb.v4.FusionLights[7] = {668,900,900,696}; # source C, cool
awb.v4.FusionInitLight = 4;
awb.LowU = 0.05;
awb.HighU = 4.0;
awb.GrayLineThickness = 1.0;
awb.NumGrayLineSoftClampPoints = 0;
awb.v4.LowU = 0.05;
awb.v4.HighU = 4.0;
awb.v4.GrayLineThickness = 1.0;
awb.v4.NumGrayLineSoftClampPoints = 0;

# The lux prior of the generic tuning pulls the white towards a
# daylight setting of another sensor in bright scenes.
awb.v4.FusionUseLux = FALSE;

# Colour matrices by the colour temperature the ISP estimates. Each
# row is an input channel.
colorCorrection.numColorCorrectionMatrices = 4;
colorCorrection.set[0].cct = 3500;
colorCorrection.set[0].ccMatrix[0] = { 2.0825, -0.7282, -0.0005, 0.0 };
colorCorrection.set[0].ccMatrix[1] = { -0.5450, 2.0517, -2.4570, 0.0 };
colorCorrection.set[0].ccMatrix[2] = { -0.5375, -0.3235, 3.4575, 0.0 };
colorCorrection.set[0].ccMatrix[3] = { 0.0, 0.0, 0.0, 1.0 };
colorCorrection.set[1].cct = 4500;
colorCorrection.set[1].ccMatrix[0] = { 2.1780, -0.5879, 0.0800, 0.0 };
colorCorrection.set[1].ccMatrix[1] = { -0.7704, 1.9581, -2.0208, 0.0 };
colorCorrection.set[1].ccMatrix[2] = { -0.4076, -0.3703, 2.9409, 0.0 };
colorCorrection.set[1].ccMatrix[3] = { 0.0, 0.0, 0.0, 1.0 };
colorCorrection.set[2].cct = 5500;
colorCorrection.set[2].ccMatrix[0] = { 2.3275, -0.5291, 0.0425, 0.0 };
colorCorrection.set[2].ccMatrix[1] = { -0.9196, 1.9560, -1.6844, 0.0 };
colorCorrection.set[2].ccMatrix[2] = { -0.4079, -0.4269, 2.6419, 0.0 };
colorCorrection.set[2].ccMatrix[3] = { 0.0, 0.0, 0.0, 1.0 };
colorCorrection.set[3].cct = 8500;
colorCorrection.set[3].ccMatrix[0] = { 1.9595, -0.4210, 0.0553, 0.0 };
colorCorrection.set[3].ccMatrix[1] = { -0.5861, 1.8103, -1.2234, 0.0 };
colorCorrection.set[3].ccMatrix[2] = { -0.3734, -0.3893, 2.1681, 0.0 };
colorCorrection.set[3].ccMatrix[3] = { 0.0, 0.0, 0.0, 1.0 };
