/dts-v1/;
/plugin/;

/*
 * SPDX-License-Identifier: GPL-2.0
 *
 * Copyright (C) 2026 Artur Andrzejczak <andrzejczak.artur@gmail.com>
 * Copyright (c) 2022-2023, NVIDIA CORPORATION & AFFILIATES
 *
 * The camera-graph skeleton (tegra-capture-vi port, NVCSI channel,
 * cam_i2cmux, gpio hog, lane polarity) is taken from NVIDIA's
 * tegra234-p3767-camera-p3768-imx219-A overlay (GPL-2.0). The OV5647
 * sensor node is this project's; its timing values derive from the
 * mainline ov5647.c mode definitions.
 *
 * Device-tree overlay: OV5647 (Raspberry Pi Camera v1) on Jetson Orin
 * Nano / Orin NX Developer Kit (P3767 module + P3768 carrier), JetPack
 * 7. Camera in the CAM0 22-pin connector, via a 15-pin to 22-pin
 * adapter ribbon.
 *
 * Unlike Nano/Xavier, the JetPack 7 base DTB has the VI and NVCSI
 * blocks but no camera graph on them: no ports, no channels, no
 * sensor, no i2c mux, no tegra-camera-platform. This overlay supplies
 * all of that, extending the three existing nodes by path
 * (tegra-capture-vi, the NVCSI controller, the main GPIO node) and
 * taking three phandle references: &gpio (sensor PWDN), &gpio_aon and
 * &cam_i2c (i2c mux).
 *
 * CAM0 on this carrier is CSI serial_b / port-index 1 with swapped lane
 * polarity (lane_polarity = "6"), both taken from NVIDIA's overlay for
 * this connector rather than measured, since no camera has been on this
 * board yet. Carry them into any mode added here.
 */

/ {
	overlay-name = "Camera OV5647 (Pi Camera v1)";
	jetson-header-name = "Jetson 22pin CSI Connector";
	compatible = "nvidia,p3768-0000+p3767-0000",
		     "nvidia,p3768-0000+p3767-0001",
		     "nvidia,p3768-0000+p3767-0003",
		     "nvidia,p3768-0000+p3767-0004",
		     "nvidia,p3768-0000+p3767-0005",
		     "nvidia,p3768-0000+p3767-0000-super",
		     "nvidia,p3768-0000+p3767-0001-super",
		     "nvidia,p3768-0000+p3767-0003-super",
		     "nvidia,p3768-0000+p3767-0004-super",
		     "nvidia,p3768-0000+p3767-0005-super";

	fragment@0 {
		target-path = "/";
		__overlay__ {

			tegra-capture-vi {
				num-channels = <1>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						rbpcv1_ov5647_vi_in0: endpoint {
							port-index = <1>;
							bus-width = <2>;
							remote-endpoint =
								<&rbpcv1_ov5647_csi_out0>;
						};
					};
				};
			};

			tegra-camera-platform {
				compatible = "nvidia, tegra-camera-platform";

				modules {
					module0 {
						badge = "jakku_front_RBPCV1";
						position = "front";
						orientation = "1";

						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree =
								"/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/rbpcv1_ov5647_a@36";
						};
						drivernode1 {
							pcl_id = "v4l2_lens";
							sysfs-device-tree =
								"/sys/firmware/devicetree/base/bus@0/lens_ov5647@RBPCV1";
						};
					};
				};
			};

			bus@0 {

				host1x@13e00000 {

					nvcsi@15a00000 {
						num-channels = <1>;
						#address-cells = <1>;
						#size-cells = <0>;

						channel@0 {
							reg = <0>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;

								port@0 {
									reg = <0>;
									rbpcv1_ov5647_csi_in0: endpoint@0 {
										port-index = <1>;
										bus-width = <2>;
										remote-endpoint =
											<&rbpcv1_ov5647_out0>;
									};
								};
								port@1 {
									reg = <1>;
									rbpcv1_ov5647_csi_out0: endpoint@1 {
										remote-endpoint =
											<&rbpcv1_ov5647_vi_in0>;
									};
								};
							};
						};
					};
				};

				cam_i2cmux {
					status = "okay";
					compatible = "i2c-mux-gpio";
					#address-cells = <1>;
					#size-cells = <0>;
					mux-gpios = <&gpio_aon 0x13 0>;
					i2c-parent = <&cam_i2c>;

					i2c@0 {
						status = "okay";
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;

						rbpcv1_ov5647_a@36 {
							compatible = "nvidia,ov5647";
							reg = <0x36>;

							devnode = "video0";

							/* pixel array: 2592 x 1944 at 1.4 um */
							physical_w = "3.629";
							physical_h = "2.722";

							sensor_model = "ov5647";
							use_sensor_mode_id = "true";

							/* CAM0_PWDN, same pin the stock
							 * IMX219 uses */
							reset-gpios = <&gpio 0x3e 0>;

							mode0 { /* OV5647_MODE_2592x1944_15FPS */
								mclk_khz = "25000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								lane_polarity = "6";
								phy_mode = "DPHY";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";

								active_w = "2592";
								active_h = "1944";
								mode_type = "bayer";
								pixel_phase = "bggr";
								csi_pixel_bit_depth = "10";
								readout_orientation = "0";
								line_length = "2844";
								inherent_gain = "1";
								mclk_multiplier = "3.50";
								pix_clk_hz = "87500000";

								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "16";
								max_gain_val = "1023";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "15000000";
								step_framerate = "1";
								default_framerate = "15000000";
								min_exp_time = "131";
								max_exp_time = "500000";
								step_exp_time = "1";
								default_exp_time = "16666";

								embedded_metadata_height = "0";
							};
							mode1 { /* OV5647_MODE_1920x1080_30FPS */
								mclk_khz = "25000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								lane_polarity = "6";
								phy_mode = "DPHY";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";

								active_w = "1920";
								active_h = "1080";
								mode_type = "bayer";
								pixel_phase = "bggr";
								csi_pixel_bit_depth = "10";
								readout_orientation = "0";
								line_length = "2416";
								inherent_gain = "1";
								mclk_multiplier = "3.27";
								pix_clk_hz = "81666700";

								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "16";
								max_gain_val = "1023";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "30000000";
								step_framerate = "1";
								default_framerate = "30000000";
								min_exp_time = "119";
								max_exp_time = "500000";
								step_exp_time = "1";
								default_exp_time = "16666";

								embedded_metadata_height = "0";
							};
							mode2 { /* OV5647_MODE_1296x972_30FPS */
								mclk_khz = "25000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								lane_polarity = "6";
								phy_mode = "DPHY";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";

								active_w = "1296";
								active_h = "972";
								mode_type = "bayer";
								pixel_phase = "bggr";
								csi_pixel_bit_depth = "10";
								readout_orientation = "0";
								line_length = "1896";
								inherent_gain = "1";
								mclk_multiplier = "3.27";
								pix_clk_hz = "81666700";

								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "16";
								max_gain_val = "1023";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "30000000";
								step_framerate = "1";
								default_framerate = "30000000";
								min_exp_time = "93";
								max_exp_time = "500000";
								step_exp_time = "1";
								default_exp_time = "16666";

								embedded_metadata_height = "0";
							};
							mode3 { /* OV5647_MODE_640x480_62FPS */
								mclk_khz = "25000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								lane_polarity = "6";
								phy_mode = "DPHY";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";

								active_w = "640";
								active_h = "480";
								mode_type = "bayer";
								pixel_phase = "bggr";
								csi_pixel_bit_depth = "10";
								readout_orientation = "0";
								line_length = "1852";
								inherent_gain = "1";
								mclk_multiplier = "2.33";
								pix_clk_hz = "58333300";

								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "16";
								max_gain_val = "1023";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "62000000";
								step_framerate = "1";
								default_framerate = "62000000";
								min_exp_time = "127";
								max_exp_time = "500000";
								step_exp_time = "1";
								default_exp_time = "16666";

								embedded_metadata_height = "0";
							};

							ports {
								#address-cells = <1>;
								#size-cells = <0>;

								port@0 {
									reg = <0>;
									rbpcv1_ov5647_out0: endpoint {
										port-index = <1>;
										bus-width = <2>;
										remote-endpoint =
											<&rbpcv1_ov5647_csi_in0>;
									};
								};
							};
						};
					};
				};

				/* fixed-focus Pi Camera v1 lens, queried by Argus */
				lens_ov5647@RBPCV1 {
					min_focus_distance = "0.0";
					hyper_focal = "0.0";
					focal_length = "3.60";
					f_number = "2.9";
					aperture = "0.0";
				};

				/* cam0-rst hog as in NVIDIA's IMX219-A overlay.
				 * That overlay also hogs the pwdn pins on a
				 * gpio@6000d000 node, a tegra210-era address
				 * with no counterpart on tegra234; the dead
				 * node is omitted here. */
				gpio@2200000 {
					camera-control-output-low {
						gpio-hog;
						output-low;
						gpios = <0x3b 0>;
						label = "cam0-rst";
					};
				};
			};
		};
	};
};
